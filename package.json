{
  "name": "world-refiner",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n VITE,ELECTRON -c cyan,magenta \"npm run _vite\" \"npm run _electron\"",
    "prod": "concurrently -k -n VITE,ELECTRON -c cyan,magenta \"npm run _electron\"",
    "_vite": "vite",
    "_electron": "wait-on http://localhost:5173 && electron .",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "start:electron": "npx electron ."
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.1",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.41.0",
    "@dagrejs/dagre": "^1.1.8",
    "clsx": "^2.1.1",
    "dompurify": "^3.3.3",
    "framer-motion": "^11.18.2",
    "fuse.js": "^7.3.0",
    "idb": "^8.0.3",
    "lucide-react": "^0.400.0",
    "marked": "^12.0.2",
    "nanoid": "^5.1.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "reactflow": "^11.11.4",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@types/dagre": "^0.7.54",
    "@types/dompurify": "^3.0.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.27",
    "concurrently": "^9.2.1",
    "electron": "^41.2.0",
    "postcss": "^8.5.9",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "wait-on": "^9.0.4"
  }
}
